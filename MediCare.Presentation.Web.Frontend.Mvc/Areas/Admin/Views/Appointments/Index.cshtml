@model IReadOnlyCollection<MediCare.Application.BackEnd.Dto.AppointmentDto.ClinicAppointmentDto>
@using MediCare.Common.Enum

@{
    ViewData["Title"] = "Clinic appointments";
}

<section class="container-fluid py-4">
    <h1 class="h3 mb-1">Clinic appointments</h1>
    <p class="text-secondary mb-4">Appointments for your clinic, with patient and doctor details.</p>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }
    @if (ViewBag.Error is string loadError)
    {
        <div class="alert alert-warning" role="alert">@loadError</div>
    }

    <div class="card border-0 shadow-sm"><div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Date & time (UTC)</th><th>Patient</th><th>Doctor</th><th>Fee</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var appointment in Model)
            {
                <tr>
                    <td>@appointment.StartAt.ToString("ddd, dd MMM yyyy · HH:mm")</td>
                    <td>@appointment.PatientName</td>
                    <td>Dr. @appointment.DoctorName</td>
                    <td>@appointment.ConsultationFee.ToString("0.##") EGP</td>
                    <td><span class="badge @(appointment.StatusId == (int)AppointmentStatusEnum.Confirmed ? "text-bg-success" : appointment.StatusId == (int)AppointmentStatusEnum.Cancelled ? "text-bg-secondary" : "text-bg-primary")">@appointment.Status</span></td>
                    <td class="text-end">
                        @if (appointment.StatusId == (int)AppointmentStatusEnum.Confirmed && appointment.StartAt > DateTime.UtcNow)
                        {
                            <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this appointment?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-4">No appointments found for this clinic.</td></tr>
            }
            </tbody>
        </table>
    </div></div>
</section>
