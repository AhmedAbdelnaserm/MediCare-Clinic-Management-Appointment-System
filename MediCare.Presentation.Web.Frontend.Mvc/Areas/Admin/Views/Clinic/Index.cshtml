@model MediCare.Application.BackEnd.Dto.ClinicDto.ClinicDto

@{
    ViewData["Title"] = "My Clinic";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>My Clinic</h2>
            <p class="text-muted mb-0">View and manage your clinic information.</p>
        </div>

        @if (Model != null)
        {
            <a asp-action="Edit" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>
                Edit Clinic
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model != null)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <h4 class="mb-4">@Model.EnName</h4>

                <div class="row">

                    <div class="col-md-6 mb-4">
                        <small class="text-muted">Clinic ID</small>
                        <div class="fw-semibold">@Model.ClinicId</div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <small class="text-muted">Clinic Name</small>
                        <div class="fw-semibold">@Model.EnName</div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <small class="text-muted">Phone Number</small>
                        <div class="fw-semibold">
                            @(Model.PhoneNumber ?? "-")
                        </div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <small class="text-muted">Area</small>
                        <div class="fw-semibold">@Model.AreaName</div>
                    </div>

                    <div class="col-12 mb-4">
                        <small class="text-muted">Address</small>
                        <div class="fw-semibold">@Model.Address</div>
                    </div>

                    <div class="col-12">
                        <small class="text-muted">Description</small>
                        <div>
                            @(string.IsNullOrWhiteSpace(Model.EnDescription)
                                ? "-"
                                : Model.EnDescription)
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }
</div>