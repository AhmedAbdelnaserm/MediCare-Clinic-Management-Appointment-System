@{
    ViewData["Title"] = "Clinic Dashboard";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2>Clinic Dashboard</h2>
        <p class="text-muted">Manage your clinic operations from one place.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Doctors</h5>
                    <p class="card-text text-muted">Manage doctors assigned to your clinic and their working hours.</p>
                    <a asp-area="Admin"
                       asp-controller="Doctors"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Doctors
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Patients</h5>
                    <p class="card-text text-muted">View and manage clinic patients.</p>
                    <span class="text-muted">Coming soon</span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Appointments</h5>
                    <p class="card-text text-muted">View and manage clinic appointments.</p>
                    <span class="text-muted">Coming soon</span>
                </div>
            </div>
        </div>
    </div>
</div>