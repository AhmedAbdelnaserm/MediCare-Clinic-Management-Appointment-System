@model List<MediCare.Application.BackEnd.Dto.ClinicDoctorDto.ClinicDoctorDto>

@{
    ViewData["Title"] = "Clinic Doctors";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Clinic Doctors</h2>

        <a asp-action="Add" class="btn btn-primary">
            Add Doctor
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No doctors are currently assigned to this clinic.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Doctor</th>
                        <th>Specialization</th>
                        <th>Duration</th>
                        <th>Working Hours</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var doctor in Model)
                    {
                        <tr>
                            <td>
                                <strong>@doctor.DoctorName</strong>
                                <br />
                                <small>@doctor.DoctorEmail</small>
                            </td>

                            <td>@doctor.SpecializationName</td>

                            <td>
                                @doctor.ConsultationDurationMinutes minutes
                            </td>

                            <td>
                                @foreach (var hour in doctor.WorkingHours)
                                {
                                    <div>
                                        <strong>@hour.DayOfWeek</strong>:
                                        @hour.StartTime.ToString("HH:mm")
                                        -
                                        @hour.EndTime.ToString("HH:mm")
                                    </div>
                                }
                            </td>

                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@doctor.ClinicDoctorId"
                                   class="btn btn-sm btn-warning">
                                    Edit Schedule
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@doctor.ClinicDoctorId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Remove this doctor from your clinic?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>