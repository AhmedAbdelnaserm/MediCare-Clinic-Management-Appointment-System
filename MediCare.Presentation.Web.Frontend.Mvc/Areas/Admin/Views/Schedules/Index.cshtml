@model IReadOnlyCollection<MediCare.Application.BackEnd.Dto.AppointmentDto.ClinicDoctorScheduleSummaryDto>

@{
    ViewData["Title"] = "Clinic schedules";
}

<section class="container-fluid py-4">
    <h1 class="h3 mb-1">Doctors and schedules</h1>
    <p class="text-secondary mb-4">Manage appointment availability for your clinic.</p>
    <div class="card border-0 shadow-sm"><div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Doctor</th><th>Specialty</th><th>Visit length</th><th>Working days</th><th></th></tr></thead>
            <tbody>
            @foreach (var link in Model)
            {
                <tr>
                    <td>Dr. @link.DoctorName</td><td>@link.SpecializationName</td>
                    <td>@link.ConsultationDurationMinutes min</td><td>@link.WorkingDaysCount</td>
                    <td class="text-end"><a asp-action="Configure" asp-route-id="@link.ClinicDoctorId" class="btn btn-sm btn-outline-primary">Manage schedule</a></td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-secondary py-4">There are no doctors assigned to this clinic yet. Contact your platform administrator.</td></tr>
            }
            </tbody>
        </table>
    </div></div>
</section>
