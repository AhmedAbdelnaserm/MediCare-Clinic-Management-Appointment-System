@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="container py-4">
    <h2 class="mb-3">Doctor Dashboard</h2>
            <p class="text-muted">Manage your professional profile and view the clinics connected to your doctor account.</p>
    <div class="row g-3">
        <div class="col-md-6"><div class="card h-100"><div class="card-body">
            <h5 class="card-title">Professional Profile</h5>
            <p class="card-text">Update your profile photo, specialization, degree, and professional description.</p>
            <button type="button" class="btn btn-primary" onclick="document.getElementById('doctorProfileOpen')?.click()">Edit profile</button>
        </div></div></div>
        <div class="col-md-6"><div class="card h-100"><div class="card-body">
            <h5 class="card-title">My Clinics</h5>
            <p class="card-text">View clinics where your doctor account is assigned.</p>
            <a asp-area="Doctor" asp-controller="DoctorClinic" asp-action="Index" class="btn btn-outline-primary">View clinics</a>
        </div></div></div>
    </div>
</div>
