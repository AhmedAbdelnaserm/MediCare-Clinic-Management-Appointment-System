@model MediCare.Presentation.Web.Frontend.Mvc.Areas.Patient.ViewModels.AppointmentsViewModel
@using MediCare.Common.Enum

@{
    ViewData["Title"] = "Appointments";
}

<section class="container-fluid py-4">
    <header class="mb-4">
        <p class="text-uppercase text-secondary small mb-2">Your care, organized</p>
        <h1 class="h3 mb-1">Appointments</h1>
        <p class="text-secondary mb-0">Choose an open time. Your booking is confirmed immediately.</p>
    </header>

    @if (TempData["AppointmentMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    @if (TempData["AppointmentError"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">Available appointments</h2>
                    <p class="text-secondary small mb-0">Times are reserved only after you confirm.</p>
                </div>
                <form method="get" asp-action="Index" class="d-flex gap-2">
                    <select name="doctorId" asp-items="Model.Doctors" class="form-select" aria-label="Filter by doctor">
                        <option value="">All doctors</option>
                    </select>
                    <button class="btn btn-outline-primary" type="submit">Filter</button>
                </form>
            </div>

            @if (Model.AvailableSlots.Count == 0)
            {
                <div class="text-center py-4">
                    <h3 class="h6">No open times are available</h3>
                    <p class="text-secondary mb-0">Try another doctor or check back later.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Doctor & clinic</th><th>Date and time</th><th>Fee</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var slot in Model.AvailableSlots)
                        {
                            <tr>
                                <td><strong>Dr. @slot.DoctorName</strong><br /><span class="small text-secondary">@slot.ClinicName · @slot.ClinicAddress</span></td>
                                <td>@slot.StartAt.ToString("ddd, dd MMM yyyy · HH:mm")</td>
                                <td>@slot.ConsultationFee.ToString("0.##") EGP</td>
                                <td class="text-end">
                                    <form asp-action="Book" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="slotId" value="@slot.SlotId" />
                                        <button type="submit" class="btn btn-primary btn-sm">Book</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">My appointments</h2>
            @if (Model.MyAppointments.Count == 0)
            {
                <p class="text-secondary mb-0">You do not have any appointments yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Doctor & clinic</th><th>Date and time</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var appointment in Model.MyAppointments)
                        {
                            <tr>
                                <td><strong>Dr. @appointment.DoctorName</strong><br /><span class="small text-secondary">@appointment.ClinicName · @appointment.ClinicAddress</span></td>
                                <td>@appointment.StartAt.ToString("ddd, dd MMM yyyy · HH:mm")</td>
                                <td><span class="badge @(appointment.StatusId == (int)AppointmentStatusEnum.Confirmed ? "text-bg-success" : appointment.StatusId == (int)AppointmentStatusEnum.Cancelled ? "text-bg-secondary" : "text-bg-primary")">@appointment.Status</span></td>
                                <td class="text-end">
                                    @if (appointment.StatusId == (int)AppointmentStatusEnum.Confirmed && appointment.StartAt > DateTime.UtcNow)
                                    {
                                        <details class="mb-2">
                                            <summary class="small text-primary">Change time</summary>
                                            <form asp-action="Reschedule" method="post" class="d-flex gap-1 mt-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                                                <select name="slotId" class="form-select form-select-sm" aria-label="Choose a new appointment time" required>
                                                    <option value="">Choose a new time</option>
                                                    @foreach (var availableSlot in Model.AvailableSlots)
                                                    {
                                                        <option value="@availableSlot.SlotId">Dr. @availableSlot.DoctorName · @availableSlot.StartAt.ToString("dd MMM, HH:mm") · @availableSlot.ClinicName</option>
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-outline-primary btn-sm">Save</button>
                                            </form>
                                        </details>
                                        <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this appointment?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>
