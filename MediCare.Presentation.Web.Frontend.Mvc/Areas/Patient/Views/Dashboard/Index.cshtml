@{
    ViewData["Title"] = "Patient Dashboard";
}

<section class="container-fluid py-4">
    <p class="text-uppercase text-secondary small mb-2">Patient workspace</p>
    <h1 class="h3 mb-2">Welcome, @User.Identity?.Name</h1>
    <p class="text-secondary mb-4">You are signed in to your MediCare patient account.</p>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h2 class="h5">Find care near you</h2>
            <p class="text-secondary">Browse the doctors currently listed on MediCare, including their specialties, clinics, and consultation fees.</p>
            <a asp-area="Patient" asp-controller="Doctors" asp-action="Index" class="btn btn-primary">Browse doctors</a>
            <a asp-area="Patient" asp-controller="Appointments" asp-action="Index" class="btn btn-outline-primary ms-2">My appointments</a>
        </div>
    </div>
</section>
