@model IReadOnlyCollection<MediCare.Application.BackEnd.Dto.MedicalRecordDto.MedicalRecordResponseDto>

@{
    ViewData["Title"] = "Medical records";
}

<section class="container-fluid py-4">
    <p class="text-uppercase text-secondary small mb-2">Your health history</p>
    <h1 class="h3 mb-4">Medical records</h1>

    @if (TempData["RecordsError"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm"><div class="card-body p-4">
            <h2 class="h5">No records yet</h2>
            <p class="text-secondary mb-0">After a visit, your doctor can add the diagnosis and treatment details here.</p>
        </div></div>
    }
    else
    {
        <div class="accordion" id="medicalRecords">
            @foreach (var record in Model)
            {
                <article class="accordion-item">
                    <h2 class="accordion-header" id="record-heading-@record.MedicalRecordId">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#record-body-@record.MedicalRecordId" aria-expanded="false">
                            <span><strong>@record.AppointmentAt.ToString("dd MMM yyyy")</strong> · Dr. @record.DoctorName · @record.Diagnosis</span>
                        </button>
                    </h2>
                    <div id="record-body-@record.MedicalRecordId" class="accordion-collapse collapse" data-bs-parent="#medicalRecords">
                        <div class="accordion-body">
                            @if (record.Attachments.Count > 0)
                            {
                                <h3 class="h6">Clinical attachments</h3>
                                <ul>@foreach (var attachment in record.Attachments) { <li><a asp-action="DownloadAttachment" asp-route-id="@attachment.AttachmentId">@attachment.FileName</a></li> }</ul>
                            }
                            @if (!string.IsNullOrWhiteSpace(record.Symptoms))
                            {
                                <h3 class="h6">Symptoms</h3><p>@record.Symptoms</p>
                            }
                            <h3 class="h6">Diagnosis</h3><p>@record.Diagnosis</p>
                            @if (!string.IsNullOrWhiteSpace(record.TreatmentNotes))
                            {
                                <h3 class="h6">Treatment notes</h3><p>@record.TreatmentNotes</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(record.PrescriptionInstructions) || record.PrescriptionItems.Count > 0)
                            {
                                <h3 class="h6">Prescription</h3>
                                @if (!string.IsNullOrWhiteSpace(record.PrescriptionInstructions))
                                {
                                    <p>@record.PrescriptionInstructions</p>
                                }
                                @if (record.PrescriptionItems.Count > 0)
                                {
                                    <ul class="mb-0">
                                    @foreach (var item in record.PrescriptionItems)
                                    {
                                        <li><strong>@item.MedicationName</strong>@if (!string.IsNullOrWhiteSpace(item.Dosage)){<text> — @item.Dosage</text>}@if (!string.IsNullOrWhiteSpace(item.Frequency)){<text>, @item.Frequency</text>}@if (!string.IsNullOrWhiteSpace(item.Duration)){<text> for @item.Duration</text>}@if (!string.IsNullOrWhiteSpace(item.Instructions)){<text>. @item.Instructions</text>}</li>
                                    }
                                    </ul>
                                }
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>
