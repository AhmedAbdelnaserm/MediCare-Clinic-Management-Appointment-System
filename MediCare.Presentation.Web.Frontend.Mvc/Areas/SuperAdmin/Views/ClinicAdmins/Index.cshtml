@model List<MediCare.Application.Identity.Dto.ClinicAdminDto.ClinicAdminDto>

@{
    ViewData["Title"] = "Clinic Admins";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Clinic Admins</h2>

    <a asp-area="SuperAdmin"
       asp-controller="ClinicAdmins"
       asp-action="Create"
       class="btn btn-primary">
        Add Clinic Admin
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Clinic</th>
                <th>Status</th>
                <th style="width: 230px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Any())
            {
                @foreach (var admin in Model)
                {
                    <tr>
                        <td>@admin.FullName</td>
                        <td>@admin.Email</td>
                        <td>@admin.PhoneNumber</td>
                        <td>@admin.ClinicName</td>

                        <td>
                            @if (admin.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@admin.UserId"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@admin.UserId"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <form asp-area="SuperAdmin"
                                  asp-controller="ClinicAdmins"
                                  asp-action="ToggleStatus"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@admin.UserId" />

                                @if (admin.IsActive)
                                {
                                    <input type="hidden"
                                           name="isActive"
                                           value="false" />

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('Deactivate this clinic admin?')">
                                        Deactivate
                                    </button>
                                }
                                else
                                {
                                    <input type="hidden"
                                           name="isActive"
                                           value="true" />

                                    <button type="submit"
                                            class="btn btn-sm btn-success"
                                            onclick="return confirm('Activate this clinic admin?')">
                                        Activate
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        No clinic admins found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
