@model MediCare.Application.BackEnd.Dto.ClinicDto.ClinicDto

@{
    ViewData["Title"] = "Clinic Details";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Clinic Details</h2>
            <p class="text-muted mb-0">View clinic information.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.ClinicId"
               class="btn btn-primary">Edit Clinic</a>

            <a asp-action="Index" class="btn btn-light">Back</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h4 class="mb-4">@Model.EnName</h4>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <small class="text-muted">Clinic ID</small>
                    <div class="fw-semibold">@Model.ClinicId</div>
                </div>

                <div class="col-md-6 mb-4">
                    <small class="text-muted">Clinic Name</small>
                    <div class="fw-semibold">@Model.EnName</div>
                </div>

                <div class="col-md-6 mb-4">
                    <small class="text-muted">Phone Number</small>
                    <div class="fw-semibold">@(Model.PhoneNumber ?? "-")</div>
                </div>

                <div class="col-md-6 mb-4">
                    <small class="text-muted">Area</small>
                    <div class="fw-semibold">@Model.AreaName</div>
                </div>

                <div class="col-12 mb-4">
                    <small class="text-muted">Address</small>
                    <div class="fw-semibold">@Model.Address</div>
                </div>

                <div class="col-12">
                    <small class="text-muted">Description</small>
                    <div>
                        @(string.IsNullOrWhiteSpace(Model.EnDescription)
                        ? "-"
                        : Model.EnDescription)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
