@model List<MediCare.Application.BackEnd.Dto.ClinicDto.ClinicDto>

@{
    ViewData["Title"] = "Clinics";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Clinics</h2>
            <p class="text-muted mb-0">Manage all registered clinics.</p>
        </div>

        <a asp-area="SuperAdmin"
           asp-controller="Clinics"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Clinic
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null || ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @(TempData["Error"] ?? ViewBag.Error)
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Clinic Name</th>
                            <th>Address</th>
                            <th>Phone</th>
                            <th>Area</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var clinic in Model)
                            {
                                <tr>
                                    <td>@clinic.ClinicId</td>
                                    <td class="fw-semibold">@clinic.EnName</td>
                                    <td>@clinic.Address</td>
                                    <td>@(clinic.PhoneNumber ?? "-")</td>
                                    <td>@clinic.AreaName</td>

                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@clinic.ClinicId"
                                               class="btn btn-sm btn-outline-info"
                                               title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@clinic.ClinicId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@clinic.ClinicId"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this clinic?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No clinics found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
