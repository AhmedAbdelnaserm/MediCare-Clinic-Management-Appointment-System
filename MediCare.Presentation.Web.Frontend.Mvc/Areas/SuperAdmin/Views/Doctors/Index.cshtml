@model IReadOnlyCollection<MediCare.Application.BackEnd.Dto.DoctorDto.DoctorResponseDto>

@{
    ViewData["Title"] = "Doctors";
}

<section class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="h3 mb-1">Doctors</h1><p class="text-secondary mb-0">Create doctor accounts and profiles.</p></div>
        <a asp-action="Create" class="btn btn-primary">Add doctor</a>
    </div>
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (ViewBag.Error is string error)
    {
        <div class="alert alert-warning">@error</div>
    }
    <div class="card border-0 shadow-sm"><div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Doctor</th><th>Specialty</th><th>Clinic</th><th>Consultation fee</th></tr></thead>
            <tbody>
            @foreach (var doctor in Model)
            {
                <tr><td>Dr. @doctor.DoctorName</td><td>@doctor.SpecializationName</td><td>@(string.IsNullOrWhiteSpace(doctor.ClinicName) ? "Not assigned" : doctor.ClinicName)</td><td>@doctor.ConsultationFee.ToString("0.##") EGP</td></tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-secondary py-4">No doctors found yet.</td></tr>
            }
            </tbody>
        </table>
    </div></div>
</section>
