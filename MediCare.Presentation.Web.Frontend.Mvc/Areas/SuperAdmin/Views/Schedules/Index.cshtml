@model MediCare.Application.BackEnd.Dto.AppointmentDto.CreateClinicDoctorScheduleDto
@using Microsoft.AspNetCore.Mvc.Rendering
@using MediCare.Application.BackEnd.Dto.AppointmentDto

@{
    ViewData["Title"] = "Clinic schedules";
    var clinics = ViewBag.Clinics as List<SelectListItem> ?? [];
    var doctors = ViewBag.Doctors as List<SelectListItem> ?? [];
    var links = ViewBag.Links as List<ClinicDoctorScheduleSummaryDto> ?? [];
}

<section class="container py-4" style="max-width: 760px">
    <p class="text-uppercase text-secondary small mb-2">Clinic operations</p>
    <h1 class="h3 mb-1">Assign a doctor to a clinic</h1>
    <p class="text-secondary mb-4">Choose the visit length first. You will set the weekly hours in the next step.</p>
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    <form asp-action="Assign" method="post" class="card border-0 shadow-sm"><div class="card-body p-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="ClinicId" class="form-label">Clinic</label><select asp-for="ClinicId" asp-items="clinics" class="form-select"><option value="0">Choose a clinic</option></select><span asp-validation-for="ClinicId" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="DoctorId" class="form-label">Doctor</label><select asp-for="DoctorId" asp-items="doctors" class="form-select"><option value="0">Choose a doctor</option></select><span asp-validation-for="DoctorId" class="text-danger"></span></div>
        <div class="mb-4"><label asp-for="ConsultationDurationMinutes" class="form-label">Visit duration (minutes)</label><input asp-for="ConsultationDurationMinutes" class="form-control" type="number" min="5" max="240" step="5" /><span asp-validation-for="ConsultationDurationMinutes" class="text-danger"></span></div>
        <div class="d-flex justify-content-end"><button class="btn btn-primary" type="submit">Continue to weekly hours</button></div>
    </div></form>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">Doctor assignments</h2>
            @if (links.Count == 0)
            {
                <p class="text-secondary mb-0">No doctors are assigned to clinics yet.</p>
            }
            else
            {
                <div class="table-responsive"><table class="table align-middle mb-0">
                    <thead><tr><th>Clinic</th><th>Doctor</th><th>Visit length</th><th>Schedule</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var link in links)
                    {
                        <tr>
                            <td>@link.ClinicName</td>
                            <td>Dr. @link.DoctorName<br /><span class="small text-secondary">@link.SpecializationName</span></td>
                            <td>@link.ConsultationDurationMinutes min</td>
                            <td>@link.WorkingDaysCount working day(s)</td>
                            <td class="text-end"><a asp-action="Configure" asp-route-id="@link.ClinicDoctorId" class="btn btn-sm btn-outline-primary">Configure</a></td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
