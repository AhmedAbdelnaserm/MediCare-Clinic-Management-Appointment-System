@model MediCare.Application.BackEnd.Dto.Dto.Specialization.CreateSpecializationDto

@{
    ViewData["Title"] = "Add Specialization";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">Add Specialization / إضافة تخصص جديد</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- English Section -->
                        <h6 class="text-primary border-bottom pb-2">English Details</h6>
                        <div class="mb-3">
                            <label asp-for="EnName" class="form-label">English Name *</label>
                            <input asp-for="EnName" class="form-control" placeholder="e.g. Cardiology" />
                            <span asp-validation-for="EnName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="EnDescription" class="form-label">English Description</label>
                            <textarea asp-for="EnDescription" class="form-control" rows="3" placeholder="Provide an optional summary..."></textarea>
                            <span asp-validation-for="EnDescription" class="text-danger"></span>
                        </div>

                        <!-- Arabic Section -->
                        <h6 class="text-primary border-bottom pb-2 mt-4">Arabic Details (البيانات بالعربية)</h6>
                        <div class="mb-3">
                            <label asp-for="ArName" class="form-label">Arabic Name (الاسم بالعربية) *</label>
                            <input asp-for="ArName" class="form-control text-end" dir="rtl" placeholder="مثال: طب وجراحة القلب" />
                            <span asp-validation-for="ArName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ArDescription" class="form-label">Arabic Description (الوصف بالعربية)</label>
                            <textarea asp-for="ArDescription" class="form-control text-end" dir="rtl" rows="3" placeholder="أدخل نبذة مختصرة عن التخصص..."></textarea>
                            <span asp-validation-for="ArDescription" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                            <button type="submit" class="btn btn-primary px-4">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}