@model MediCare.Application.BackEnd.Dto.Dto.Specialization.SpecializationDto

@{
    ViewData["Title"] = "Delete Specialization";
}

<div class="container my-4">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white py-3">
            <h5 class="mb-0">Confirm Delete / تأكيد الحذف</h5>
        </div>
        <div class="card-body p-4">
            <p class="lead text-danger fw-bold">Are you sure you want to permanently delete this specialization?</p>

            <dl class="row mt-4">
                <dt class="col-sm-3 text-muted">ID</dt>
                <dd class="col-sm-9">#@Model.SpecializationId</dd>

                <dt class="col-sm-3 text-muted">English Name</dt>
                <dd class="col-sm-9 fw-semibold">@Model.EnName</dd>

                <dt class="col-sm-3 text-muted">Arabic Name</dt>
                <dd class="col-sm-9 fw-semibold" dir="rtl">@Model.ArName</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.SpecializationId" method="post">
                <input type="hidden" asp-for="SpecializationId" />
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4">Delete Permanently</button>
                </div>
            </form>
        </div>
    </div>
</div>