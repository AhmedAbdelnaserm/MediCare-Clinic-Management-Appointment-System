@model MediCare.Application.BackEnd.Dto.Dto.Specialization.UpdateSpecializationDto

@{
    ViewData["Title"] = "Edit Specialization";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark py-3">
                    <h5 class="mb-0">Edit Specialization #@Model.SpecializationId</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.SpecializationId" method="post">
                        <input type="hidden" asp-for="SpecializationId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- English Section -->
                        <h6 class="text-dark border-bottom pb-2">English Details</h6>
                        <div class="mb-3">
                            <label asp-for="EnName" class="form-label">English Name *</label>
                            <input asp-for="EnName" class="form-control" />
                            <span asp-validation-for="EnName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="EnDescription" class="form-label">English Description</label>
                            <textarea asp-for="EnDescription" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="EnDescription" class="text-danger"></span>
                        </div>

                        <!-- Arabic Section -->
                        <h6 class="text-dark border-bottom pb-2 mt-4">Arabic Details (البيانات بالعربية)</h6>
                        <div class="mb-3">
                            <label asp-for="ArName" class="form-label">Arabic Name (الاسم بالعربية) *</label>
                            <input asp-for="ArName" class="form-control text-end" dir="rtl" />
                            <span asp-validation-for="ArName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ArDescription" class="form-label">Arabic Description (الوصف بالعربية)</label>
                            <textarea asp-for="ArDescription" class="form-control text-end" dir="rtl" rows="3"></textarea>
                            <span asp-validation-for="ArDescription" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-warning px-4">Update Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}