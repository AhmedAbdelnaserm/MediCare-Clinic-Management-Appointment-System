@model IEnumerable<MediCare.Application.BackEnd.Dto.Dto.Specialization.SpecializationDto>

@{
    ViewData["Title"] = "Specializations";
}

<div class="container my-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Medical Specializations</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Add New Specialization
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">ID</th>
                            <th>Active Display Name</th>
                            <th>English Name</th>
                            <th class="text-end">Arabic Name (الاسم بالعربية)</th>
                            <th class="text-end" style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.SpecializationId</td>
                                    <td><strong class="text-primary">@item.DisplayName</strong></td>
                                    <td>@item.EnName</td>
                                    <td class="text-end" dir="rtl">@item.ArName</td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.SpecializationId" class="btn btn-sm btn-outline-info">Details</a>
                                            <a asp-action="Edit" asp-route-id="@item.SpecializationId" class="btn btn-sm btn-outline-warning">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@item.SpecializationId" class="btn btn-sm btn-outline-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No specializations found. Click <strong>+ Add New Specialization</strong> to create one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>